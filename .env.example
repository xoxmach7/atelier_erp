# ===== Atelier ERP — пример переменных окружения =====
# Скопируйте в .env и заполните. .env в репозиторий не коммитится.

# --- Django ---
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-this-in-production

# DEBUG только для локальной разработки. В проде НЕ включать.
DEBUG=False

# Список хостов через запятую. Для прода — ваш домен; для LAN/ngrok — добавьте сюда.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- HTTPS / безопасность (учитываются только при DEBUG=False) ---
# Принудительный редирект на HTTPS (за прокси с X-Forwarded-Proto)
SECURE_SSL_REDIRECT=True
# Срок HSTS в секундах (по умолчанию 1 год)
SECURE_HSTS_SECONDS=31536000
# Доверенные источники для CSRF (со схемой), через запятую. Пример:
# CSRF_TRUSTED_ORIGINS=https://erp.example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=

# --- CORS (фронт/мобайл) ---
# Источники через запятую. Пример: https://erp.example.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- База данных ---
# Для прода используйте PostgreSQL (SQLite не выдерживает многопользовательскую работу).
DB_ENGINE=postgresql
DB_NAME=atelier
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
