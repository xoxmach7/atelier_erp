    seamstress_id: UUID
    completed_at: str
    payment_due: str


# ============================================
# EVENT BUS / DISPATCHER
# ============================================

class EventBus:
    """
    Simple event bus for publishing and subscribing to domain events.
    In production, this would use Celery, Redis Pub/Sub, or message queue.
    """
    
    def __init__(self):
        self._subscribers: Dict[str, List[callable]] = {}
    
    def subscribe(self, event_type: str, handler: callable):
        """Subscribe handler to event type"""
        if event_type not in self._subscribers:
            self._subscribers[event_type] = []
        self._subscribers[event_type].append(handler)
    
    def publish(self, event: DomainEvent):
        """Publish event to all subscribers"""
        event_type = event.__class__.__name__
        handlers = self._subscribers.get(event_type, [])
        
        for handler in handlers:
            try:
                handler(event)
            except Exception as e:
                # Log error but don't break other handlers
                print(f"Error handling event {event_type}: {e}")
    
    def publish_all(self, events: List[DomainEvent]):
        """Publish multiple events"""
        for event in events:
            self.publish(event)


# Global event bus instance
_event_bus = EventBus()


def get_event_bus() -> EventBus:
    """Get global event bus instance"""
    return _event_bus
