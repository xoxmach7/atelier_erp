@dataclass(frozen=True)
class FabricReservationConverted(DomainEvent):
    """Reservation converted to actual deduction"""
    reservation_id: UUID
    fabric_id: UUID
    order_id: UUID
    deducted_meters: str
    remaining_stock: str


@dataclass(frozen=True)
class FabricReservationCancelled(DomainEvent):
    reservation_id: UUID
    fabric_id: UUID
    released_meters: str
    reason: str


@dataclass(frozen=True)
class StockDeducted(DomainEvent):
    fabric_id: Optional[UUID]
    cornice_id: Optional[UUID]
    order_id: UUID
    quantity_deducted: str
    remaining_stock: str


@dataclass(frozen=True)
class StockReturned(DomainEvent):
    """Inventory returned on order cancellation"""
    fabric_id: Optional[UUID]
    cornice_id: Optional[UUID]
    order_id: UUID
    quantity_returned: str
    new_stock_level: str


@dataclass(frozen=True)
class LowStockAlert(DomainEvent):
    fabric_id: UUID
    fabric_name: str
    hanger_number: str
    current_stock: str
    reserved_amount: str
    available: str


# ============================================
# TASK EVENTS
