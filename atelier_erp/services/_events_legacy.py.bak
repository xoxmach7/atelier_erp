"""
Domain Events System
Used for loose coupling between aggregates
"""

from dataclasses import dataclass, field
from datetime import datetime
from typing import List, Optional, Dict, Any
from uuid import UUID, uuid4


@dataclass(frozen=True)
class DomainEvent:
    """Base class for all domain events"""
    event_id: UUID = field(default_factory=uuid4)
    timestamp: datetime = field(default_factory=datetime.now)
    correlation_id: Optional[UUID] = None
    
    def to_dict(self) -> Dict[str, Any]:
        """Serialize event to dict for storage/transmission"""
        return {
            'event_type': self.__class__.__name__,
            'event_id': str(self.event_id),
            'timestamp': self.timestamp.isoformat(),
            'correlation_id': str(self.correlation_id) if self.correlation_id else None,
            'data': {
                k: str(v) if isinstance(v, UUID) else v
                for k, v in self.__dict__.items()
                if k not in ('event_id', 'timestamp', 'correlation_id')
            }
        }


# ============================================
# ORDER EVENTS
# ============================================

@dataclass(frozen=True)
class OrderCreated(DomainEvent):
    order_id: UUID
    order_number: str
    customer_id: UUID
    total_amount: str
    created_by: Optional[UUID] = None


@dataclass(frozen=True)
class OrderStatusChanged(DomainEvent):
    order_id: UUID
    old_status: str
    new_status: str
    changed_by: Optional[str] = None
    reason: Optional[str] = None


@dataclass(frozen=True)
class OrderConfirmed(DomainEvent):
    """Customer confirmed the order (quote approved)"""
    order_id: UUID
    customer_id: UUID
    quote_id: Optional[UUID] = None


@dataclass(frozen=True)
class OrderMaterialsReserved(DomainEvent):
    order_id: UUID
    fabric_reservations: List[Dict[str, Any]]  # List of {fabric_id, reserved_meters, reservation_id}
    cornice_allocations: List[Dict[str, Any]]  # List of {cornice_id, quantity}


@dataclass(frozen=True)
class OrderProductionStarted(DomainEvent):
    order_id: UUID
    assigned_to: Optional[UUID] = None
    deadline: Optional[str] = None


@dataclass(frozen=True)
class OrderCompleted(DomainEvent):
    order_id: UUID
    customer_id: UUID
    completion_date: str
    total_amount: str
    total_paid: str


@dataclass(frozen=True)
class OrderCancelled(DomainEvent):
    order_id: UUID
    reason: str
    cancelled_by: Optional[str] = None
    inventory_to_release: List[Dict[str, Any]] = field(default_factory=list)


@dataclass(frozen=True)
class OrderPaymentReceived(DomainEvent):
    order_id: UUID
    payment_id: UUID
    amount: str
    payment_type: str
    is_fully_paid: bool


